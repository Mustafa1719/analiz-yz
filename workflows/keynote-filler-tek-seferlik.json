    {
      "id": "code-filter-kf",
      "name": "Filter Empty Keynote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const filtered = $input.all()\n  .filter(item => {\n    const keynote = item.json.keynote;\n    const videoId = item.json.videoId;\n    const durum = item.json.durum || '';\n    const isOnaylı = durum.includes('Onaylı') || durum.trim() === '';\n    return (!keynote || String(keynote).trim() === '') && videoId && isOnaylı;\n  });\n\n// 50'lik gruplar oluştur\nconst batches = [];\nfor (let i = 0; i < filtered.length; i += 50) {\n  const batch = filtered.slice(i, i + 50);\n  batches.push({\n    json: {\n      videoIds: batch.map(item => item.json.videoId).join(',')\n    }\n  });\n}\nreturn batches;"
      }
    },
    {
      "id": "http-yt-kf",
      "name": "Get Video Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        300
      ],
      "parameters": {
        "url": "=https://www.googleapis.com/youtube/v3/videos?part=snippet&id={{ $json.videoIds }}&key=YOUTUBE_API_KEY",
        "options": {}
      }
    },
    {
      "id": "code-desc-kf",
      "name": "Extract Description",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  for (const video of (item.json.items || [])) {\n    const videoId = video.id;\n    const description = (video.snippet?.description || '').trim();\n    if (videoId && description) {\n      results.push({ json: { videoId, keynote: description } });\n    }\n  }\n}\nreturn results;"
      }
    },
    {
      "id": "gs-update-kf",
